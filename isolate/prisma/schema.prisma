generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth & Couples ──────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  coupleId     String?
  coupleRole   Role?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  couple           Couple?          @relation(fields: [coupleId], references: [id])
  goals            Goal[]
  journalEntries   JournalEntry[]
  dailyLogs        DailyLog[]
  memories         Memory[]
  dateEvents       DateEvent[]       @relation("PlannedBy")
  missingEntries   MissingEntry[]
  timelineEvents   TimelineEvent[]
  invitationsSent  Invitation[]      @relation("SentBy")
  invitationsRecv  Invitation[]      @relation("ReceivedBy")
  loveNotesSent    LoveNote[]
  habits           Habit[]
  readingItems     ReadingItem[]
}

enum Role {
  OWNER
  MEMBER
}

model Couple {
  id        String    @id @default(cuid())
  name      String?
  startDate DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users          User[]
  sharedGoals    SharedGoal[]
  memories       Memory[]
  dateEvents     DateEvent[]
  timelineEvents TimelineEvent[]
  loveNotes      LoveNote[]
  readingItems   ReadingItem[]
}

model Invitation {
  id         String           @id @default(cuid())
  code       String           @unique
  senderId   String
  receiverId String?
  status     InvitationStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  expiresAt  DateTime

  sender   User?  @relation("SentBy", fields: [senderId], references: [id])
  receiver User?  @relation("ReceivedBy", fields: [receiverId], references: [id])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

// ── Goals ───────────────────────────────────────────

model Goal {
  id          String       @id @default(cuid())
  userId      String
  title       String
  description String?
  category    GoalCategory
  status      GoalStatus   @default(NOT_STARTED)
  progress    Int          @default(0)
  startDate   DateTime?
  targetDate  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones GoalMilestone[]
  activities DailyActivity[]
}

enum GoalCategory {
  CAREER
  HEALTH
  FITNESS
  FINANCE
  LEARNING
  PERSONAL
  OTHER
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  PAUSED
  CANCELLED
}

model GoalMilestone {
  id          String    @id @default(cuid())
  goalId      String
  title       String
  description String?
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

// ── Shared Goals ────────────────────────────────────

model SharedGoal {
  id          String       @id @default(cuid())
  coupleId    String
  title       String
  description String?
  category    GoalCategory
  status      GoalStatus   @default(NOT_STARTED)
  progress    Int          @default(0)
  startDate   DateTime?
  targetDate  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  couple     Couple              @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  milestones SharedGoalMilestone[]
}

model SharedGoalMilestone {
  id           String    @id @default(cuid())
  sharedGoalId String
  title        String
  description  String?
  isCompleted  Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  sharedGoal SharedGoal @relation(fields: [sharedGoalId], references: [id], onDelete: Cascade)
}

// ── Daily Journal ───────────────────────────────────

model JournalEntry {
  id              String     @id @default(cuid())
  userId          String
  date            DateTime   @db.Date
  summary         String?
  accomplishments String?
  learned         String?
  difficult       String?
  tomorrow        String?
  mood            Int?
  energy          Int?
  productivity    Int?
  visibility      Visibility @default(PARTNER_VISIBLE)
  imageUrl        String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model DailyLog {
  id     String   @id @default(cuid())
  userId String
  date   DateTime @db.Date

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities DailyActivity[]

  @@unique([userId, date])
}

model DailyActivity {
  id          String   @id @default(cuid())
  dailyLogId  String
  title       String
  description String?
  isCompleted Boolean  @default(false)
  goalId      String?
  createdAt   DateTime @default(now())

  dailyLog DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  goal     Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)
}

enum Visibility {
  PRIVATE
  PARTNER_VISIBLE
}

// ── Dates ───────────────────────────────────────────

model DateEvent {
  id          String   @id @default(cuid())
  coupleId    String
  plannerId   String
  title       String
  description String?
  location    String?
  date        DateTime
  type        String?
  notes       String?
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  couple  Couple @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  planner User   @relation("PlannedBy", fields: [plannerId], references: [id])
  memories Memory[]
}

// ── Memories ────────────────────────────────────────

model Memory {
  id          String    @id @default(cuid())
  coupleId    String
  userId      String?
  title       String
  description String?
  location    String?
  date        DateTime
  dateEventId String?
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  couple    Couple     @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  creator   User?      @relation(fields: [userId], references: [id])
  dateEvent DateEvent? @relation(fields: [dateEventId], references: [id])
}

// ── Missing Each Other ──────────────────────────────

model MissingEntry {
  id        String   @id @default(cuid())
  userId    String
  value     Int
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// ── Love Notes ──────────────────────────────────────

model LoveNote {
  id        String   @id @default(cuid())
  coupleId  String
  senderId  String
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  couple Couple @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  sender User   @relation(fields: [senderId], references: [id])
}

// ── Habits ──────────────────────────────────────────

model Habit {
  id        String   @id @default(cuid())
  userId    String
  name      String
  icon      String?
  color     String?
  frequency String   @default("daily") // daily, weekly
  createdAt DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries HabitEntry[]
}

model HabitEntry {
  id        String   @id @default(cuid())
  habitId   String
  date      DateTime @db.Date
  completed Boolean  @default(false)
  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
}

// ── Reading List ──────────────────────────────────────

model ReadingItem {
  id          String       @id @default(cuid())
  coupleId    String
  addedById   String
  title       String
  author      String?
  type        ReadingType  @default(BOOK)
  status      ReadingStatus @default(TO_READ)
  rating      Int?
  notes       String?
  url         String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  couple   Couple @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  addedBy  User   @relation(fields: [addedById], references: [id])
}

enum ReadingType {
  BOOK
  ARTICLE
  PODCAST
  VIDEO
}

enum ReadingStatus {
  TO_READ
  READING
  COMPLETED
  ABANDONED
}

// ── Timeline ────────────────────────────────────────

model TimelineEvent {
  id       String             @id @default(cuid())
  coupleId String
  userId   String?
  type     TimelineEventType
  title    String
  detail   String?
  date     DateTime           @default(now())

  couple Couple @relation(fields: [coupleId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])
}

enum TimelineEventType {
  GOAL_CREATED
  GOAL_COMPLETED
  MILESTONE_COMPLETED
  SHARED_GOAL_CREATED
  SHARED_GOAL_COMPLETED
  SHARED_MILESTONE_COMPLETED
  DATE_PLANNED
  DATE_COMPLETED
  MEMORY_ADDED
  JOURNAL_ENTRY
  RELATIONSHIP_EVENT
  COUPLE_CREATED
}
